<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      PrintHost::upload: the sliced G-code is sent to a printer on the network.
      A printer on the local network answers over plain http, which the desktop
      app talks to as well, so cleartext traffic is allowed for it.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 17 asks the user before an app reaches devices of the local
         network, such as the printers G-code is sent to. -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <!-- PhysicalPrinterDialog's Browse button: Wi-Fi passes the multicast replies of
         mDNS on only while the app holds a multicast lock. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- NetworkWorkService: a cloud login waiting behind the browser and an upload
         keep the network after the app's screen is left. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- OrcaSlicerService below, a specialUse foreground service: slicing:service asks
         for this permission too, but lint looks for it beside the service's declaration. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Firebase Analytics without the advertising ID: the app shows no ads. -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove" />

    <application
        android:name=".OrcinusApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.Orcinus">
        <!-- Firebase Analytics and Crashlytics collect nothing until Telemetry has read
             Stealth mode, which turns them off with every other online request. -->
        <meta-data android:name="firebase_analytics_collection_enabled" android:value="false" />
        <meta-data android:name="firebase_crashlytics_collection_enabled" android:value="false" />
        <meta-data android:name="google_analytics_adid_collection_enabled" android:value="false" />
        <meta-data android:name="google_analytics_default_allow_ad_personalization_signals" android:value="false" />
        <!-- One window, as the desktop app keeps one: files another app opens or shares come to it (onNewIntent). -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Orcinus.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- The files Plater::load_files() takes: models, projects, ZIP archives and G-code.
                 Android types a file by its extension (MimeTypeMap): .stl as application/sla, and
                 .obj, .3mf, .step, .amf and .gcode as application/octet-stream, for which it has no
                 type; tables that know .obj type it application/x-tgif. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="model/stl" />
                <data android:mimeType="model/x.stl-binary" />
                <data android:mimeType="model/x.stl-ascii" />
                <data android:mimeType="application/sla" />
                <data android:mimeType="application/vnd.ms-pki.stl" />
                <data android:mimeType="model/3mf" />
                <data android:mimeType="application/vnd.ms-package.3dmanufacturing-3dmodel+xml" />
                <data android:mimeType="model/step" />
                <data android:mimeType="application/step" />
                <data android:mimeType="model/obj" />
                <data android:mimeType="application/x-tgif" />
                <data android:mimeType="application/x-amf" />
                <data android:mimeType="image/svg+xml" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="text/x.gcode" />
                <data android:mimeType="text/x-gcode" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
            <!-- The text files among them, OBJ, ASCII STL and G-code, which apps that look
                 into a file type text/plain: by their names, so other text does not open here.
                 The glob of a path pattern takes ".*" up to the first dot, hence a pattern for
                 names with more dots. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:host="*" />
                <data android:mimeType="text/plain" />
                <data android:pathPattern=".*\\.obj" />
                <data android:pathPattern=".*\\..*\\.obj" />
                <data android:pathPattern=".*\\..*\\..*\\.obj" />
                <data android:pathPattern=".*\\.OBJ" />
                <data android:pathPattern=".*\\..*\\.OBJ" />
                <data android:pathPattern=".*\\..*\\..*\\.OBJ" />
                <data android:pathPattern=".*\\.stl" />
                <data android:pathPattern=".*\\..*\\.stl" />
                <data android:pathPattern=".*\\..*\\..*\\.stl" />
                <data android:pathPattern=".*\\.STL" />
                <data android:pathPattern=".*\\..*\\.STL" />
                <data android:pathPattern=".*\\..*\\..*\\.STL" />
                <data android:pathPattern=".*\\.gcode" />
                <data android:pathPattern=".*\\..*\\.gcode" />
                <data android:pathPattern=".*\\..*\\..*\\.gcode" />
                <data android:pathPattern=".*\\.GCODE" />
                <data android:pathPattern=".*\\..*\\.GCODE" />
                <data android:pathPattern=".*\\..*\\..*\\.GCODE" />
                <data android:pathPattern=".*\\.g" />
                <data android:pathPattern=".*\\..*\\.g" />
                <data android:pathPattern=".*\\..*\\..*\\.g" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="model/stl" />
                <data android:mimeType="model/x.stl-binary" />
                <data android:mimeType="model/x.stl-ascii" />
                <data android:mimeType="application/sla" />
                <data android:mimeType="application/vnd.ms-pki.stl" />
                <data android:mimeType="model/3mf" />
                <data android:mimeType="application/vnd.ms-package.3dmanufacturing-3dmodel+xml" />
                <data android:mimeType="model/step" />
                <data android:mimeType="application/step" />
                <data android:mimeType="model/obj" />
                <data android:mimeType="application/x-tgif" />
                <data android:mimeType="application/x-amf" />
                <data android:mimeType="image/svg+xml" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="text/x.gcode" />
                <data android:mimeType="text/x-gcode" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="model/stl" />
                <data android:mimeType="model/x.stl-binary" />
                <data android:mimeType="model/x.stl-ascii" />
                <data android:mimeType="application/sla" />
                <data android:mimeType="application/vnd.ms-pki.stl" />
                <data android:mimeType="model/3mf" />
                <data android:mimeType="application/vnd.ms-package.3dmanufacturing-3dmodel+xml" />
                <data android:mimeType="model/step" />
                <data android:mimeType="application/step" />
                <data android:mimeType="model/obj" />
                <data android:mimeType="application/x-tgif" />
                <data android:mimeType="application/x-amf" />
                <data android:mimeType="image/svg+xml" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="text/x.gcode" />
                <data android:mimeType="text/x-gcode" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>

        <service
            android:name=".NetworkWorkService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- OrcaSlicer runs in its own process: a native crash does not close the UI. -->
        <service
            android:name=".OrcaSlicerService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:process=":slicer">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Slices a 3D model chosen by the user into G-code for a 3D printer with the OrcaSlicer engine. Started from the app by the user, shows progress with a cancel action, and stops when the job ends." />
        </service>

        <!-- The G-code and projects the user shares with another app. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/shared_files" />
        </provider>
    </application>

</manifest>
