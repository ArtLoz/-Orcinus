<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      PrintHost::upload: the sliced G-code is sent to a printer on the network.
      A printer on the local network answers over plain http, which the desktop
      app talks to as well, so cleartext traffic is allowed for it.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 17 asks the user before an app reaches devices of the local
         network, such as the printers G-code is sent to. -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <application
        android:name=".OrcinusApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.Orcinus">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Orcinus.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- OrcaSlicer runs in its own process: a native crash does not close the UI. -->
        <service
            android:name=".OrcaSlicerService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:process=":slicer">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Slices a 3D model chosen by the user into G-code for a 3D printer with the OrcaSlicer engine. Started from the app by the user, shows progress with a cancel action, and stops when the job ends." />
        </service>
    </application>

</manifest>
