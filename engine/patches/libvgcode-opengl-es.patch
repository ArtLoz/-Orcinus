diff --git a/src/SegmentTemplate.cpp b/src/SegmentTemplate.cpp
index 4e692d5..9c5b20a 100644
--- a/src/SegmentTemplate.cpp
+++ b/src/SegmentTemplate.cpp
@@ -26,12 +26,24 @@ static constexpr const std::array<uint8_t, 24> VERTEX_DATA = {
     5, 7, 6, // back spike
 };
 
+#ifdef ENABLE_OPENGL_ES
+// The vertex shader places a corner by its id alone, so the eight corners are
+// shaded once per segment, VERTEX_DATA drawing their triangles by index: the
+// same picture as drawing it as 24 vertices, with a third of the shading. A
+// tile-based mobile GPU keeps every vertex it shaded for a frame in memory,
+// over a gigabyte for the 24 vertices of a million and a half segments.
+static constexpr const std::array<uint8_t, 8> CORNER_IDS = { 0, 1, 2, 3, 4, 5, 6, 7 };
+#endif // ENABLE_OPENGL_ES
+
 void SegmentTemplate::init()
 {
     if (m_vao_id != 0)
         return;
 
     m_size_in_bytes_gpu += VERTEX_DATA.size() * sizeof(uint8_t);
+#ifdef ENABLE_OPENGL_ES
+    m_size_in_bytes_gpu += CORNER_IDS.size() * sizeof(uint8_t);
+#endif // ENABLE_OPENGL_ES
 
     int curr_vertex_array;
     glsafe(glGetIntegerv(GL_VERTEX_ARRAY_BINDING, &curr_vertex_array));
@@ -43,7 +55,15 @@ void SegmentTemplate::init()
 
     glsafe(glGenBuffers(1, &m_vbo_id));
     glsafe(glBindBuffer(GL_ARRAY_BUFFER, m_vbo_id));
+#ifdef ENABLE_OPENGL_ES
+    glsafe(glBufferData(GL_ARRAY_BUFFER, CORNER_IDS.size() * sizeof(uint8_t), CORNER_IDS.data(), GL_STATIC_DRAW));
+    // The vertex array keeps the index buffer bound.
+    glsafe(glGenBuffers(1, &m_ebo_id));
+    glsafe(glBindBuffer(GL_ELEMENT_ARRAY_BUFFER, m_ebo_id));
+    glsafe(glBufferData(GL_ELEMENT_ARRAY_BUFFER, VERTEX_DATA.size() * sizeof(uint8_t), VERTEX_DATA.data(), GL_STATIC_DRAW));
+#else
     glsafe(glBufferData(GL_ARRAY_BUFFER, VERTEX_DATA.size() * sizeof(uint8_t), VERTEX_DATA.data(), GL_STATIC_DRAW));
+#endif // ENABLE_OPENGL_ES
     glsafe(glEnableVertexAttribArray(0));
 #ifdef ENABLE_OPENGL_ES
